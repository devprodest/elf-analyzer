{
  "name": "devprodest-elf-analyzer",
  "displayName": "ELF size analyzer",
  "description": "ELF analyzer. List and size of sections and elements.",
  "publisher": "ZaikinDenis",
  "icon": "img/icon.png",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/devprodest/elf-analyzer"
  },
  "bugs": {
    "url": "https://github.com/devprodest/elf-analyzer/issues"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [],
    "configuration": [
      {
        "title": "ELF size analyzer",
        "properties": {
          "devprodest-elf-analyzer.toolchain-nm-bin-path": {
            "default": "",
            "type": "string",
            "description": "Path to 'nm' execute file",
            "deprecationMessage": "This setting is deprecated. Use 'toolchain-path' and 'prefix' instead."
          },
          "devprodest-elf-analyzer.toolchain-path": {
            "default": "",
            "type": "string",
            "description": "Path to the folder containing toolchain executables (e.g., 'nm', 'readelf')."
          },
          "devprodest-elf-analyzer.prefix": {
            "default": "",
            "type": "string",
            "description": "Toolchain prefix (e.g., 'arm-none-eabi-', 'llvm-', or leave empty for native tools)."
          },
          "devprodest-elf-analyzer.show-charts": {
            "default": true,
            "type": "boolean",
            "description": "Show section charts in the sidebar."
          },
          "devprodest-elf-analyzer.show-top-15": {
            "default": true,
            "type": "boolean",
            "description": "Show the Top 15 symbols panel."
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "devprodest-elf-analyzer.elf-view",
        "displayName": "ELF size analyzer",
        "selector": [
          {
            "filenamePattern": "*.elf"
          },
          {
            "filenamePattern": "*.dylib"
          },
          {
            "filenamePattern": "*.macho"
          },
          {
            "filenamePattern": "*.o"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "build:view": "npm run build --prefix view",
    "vscode:prepublish": "npm run package",
    "package": "npm run build:view && node esbuild.js --production",
    "vscode:build": "vsce package"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2"
  }
}